# Hostinger Business Email (hello@versecuretech.com)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@versecuretech.com
SMTP_PASS=your_hostinger_email_password_here

# From / notify addresses for contact form
CONTACT_FROM="Versecure Tech <hello@versecuretech.com>"
CONTACT_NOTIFY_TO=hello@versecuretech.com,azeem.makhdum6@gmail.com,abbas585@gmail.com

# Live site URL used for logo images inside emails (must be publicly reachable)
PUBLIC_SITE_URL=https://versecuretech.com
# Set to true AFTER you upload public/email-logo.png to Hostinger so emails use the real PNG
EMAIL_LOGO_DEPLOYED=false

# --- Portal / Supabase (optional, falls back to portal-data.json) ---
# Run supabase/portal-schema.sql in the Supabase SQL editor first.
SUPABASE_URL=https://yxawhmhpcvyalferfska.supabase.co
# Use service role (preferred) or publishable/anon key so the server can verify user JWTs
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- FORGE AI CONFIGURATION ---
# The proxy server (server.mjs) supports multiple AI providers.
# It will automatically detect and prioritize the keys in this order:
# 1. Groq (Fastest & recommended for developers)
# 2. xAI/Grok
# 3. Gemini (Default fallback)

# --- Groq Configuration ---
# Paste your Groq API Key here (starts with 'gsk_')
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- xAI / Grok Configuration ---
XAI_API_KEY=
XAI_MODEL=grok-2-1212

# --- Gemini Configuration ---
GEMINI_API_KEY=

# General Override Key (Optional)
# If set, the proxy will determine the provider based on the prefix:
# 'gsk_' -> Groq, 'xai-' -> xAI, 'AIzaSy' -> Gemini
FORGE_API_KEY=

# ============================================================
# PRODUCTION CHECKLIST (Hostinger / live)
# ============================================================
# 1) Set NODE_ENV=production on the live Node process so auth is strict.
#    Or set REQUIRE_STRICT_AUTH=true explicitly.
# 2) Fill SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (Dashboard → Project Settings → API).
#    Without these, /api/admin/* and portal APIs return 503 in production.
# 3) Run supabase/portal-schema.sql in the Supabase SQL editor (tables + portal-uploads bucket).
# 4) Keep SMTP_* filled so project/ticket emails actually send.
# 5) PUBLIC_SITE_URL=https://versecuretech.com
# 6) After deploy, open https://yoursite/api/health — expect ok:true, authConfigured:true,
#    authStrict:true, portalBackend including supabase when DB keys are set.
# 7) Local dev can omit service role: auth stays relaxed-email; data uses portal-data.json.
#
NODE_ENV=development
REQUIRE_STRICT_AUTH=false
